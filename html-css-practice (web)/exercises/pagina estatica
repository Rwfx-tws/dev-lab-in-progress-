*{
    box-sizing: border-box;
}

body{
    font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
    background-color:gray;
    margin-left: 80px;
    margin-right: 80px;
}

.barra-topo{
    top: 0;
    left: 0;
    width: 100%;
    background-color:aquamarine;
    position: fixed;
    padding:10px;
    margin-bottom:2px ;
    z-index: 1000;
}

.barra-topo ul{
    margin: 0;
    padding: 0;
    list-style: none;
}

.barra-topo li{
    float: left;
    margin-right: 20px;
    margin-left: 20px;
}

.barra-topo a {
    text-decoration: none;
    color: black;
    font-weight: bold;

}

.barra-topo a:hover{
    color:red
}

.aviso{
    background-color: rgb(231, 152, 78);
    position: relative;
    padding: 6px;
    margin-top: 60px;
}
.aviso h2{
    color: rgb(192, 0, 250);
}

.mensagem{
    color: white;
    right: 3px;
}

#fechar-aviso{
    position: absolute;
    right:5px;
    top: 1px;
    background-color: red;
    color: white;
    padding: 2px;
    padding-top:0px ;
    padding-bottom: 0px;
    cursor: pointer;
}

.text1{
    margin: 30px;
}

main h1{
    color: #01fa54;
    text-align: center;
}



